# ==============================================================================
# PROYECTO DE TESIS:
# "Sistema web para administración de dispositivos y políticas de acceso
#  en redes domésticas mediante gestión de direcciones IP"
# ==============================================================================
# Copie este archivo a ".env" y ajuste los valores según su entorno local.
# NUNCA suba el archivo ".env" con secretos reales al control de versiones.

# Entorno de ejecución: development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1

# Clave secreta para firma criptográfica de sesiones y tokens CSRF.
# Genere una clave aleatoria segura con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplazar_con_una_clave_hexadecimal_aleatoria_segura

# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (Motor principal: MySQL / MariaDB)
# ==============================================================================
# Ejemplo para MySQL 8.0+ o MariaDB 10.6+:
DATABASE_URL=mysql+pymysql://usuario_bd:password_bd@localhost:3306/red_domestica_tesis?charset=utf8mb4

# Alternativa local de laboratorio (SQLite) cuando no se dispone de servidor MySQL activo:
# DATABASE_URL=sqlite:///instance/red_domestica_lab.db

# ==============================================================================
# ÁMBITO DE RED ADMINISTRADO Y MODO DE OPERACIÓN DEL ROUTER
# ==============================================================================
# Subred predeterminada administrada por el sistema (formato CIDR IPv4)
DEFAULT_NETWORK_SCOPE=192.168.1.0/24
DEFAULT_GATEWAY_IP=192.168.1.1

# Modo del adaptador de integración con el router:
# - lab_simulator : Simulador de laboratorio (identificado explícitamente en la UI; no altera redes reales)
# - passive_only  : Solo registro administrativo en base de datos sin adaptador activo
ROUTER_ADAPTER_MODE=lab_simulator

# ==============================================================================
# INICIALIZACIÓN DE ADMINISTRADOR (SOLO PARA EL COMANDO CLI `flask init-admin`)
# ==============================================================================
# Deje estos valores vacíos en producción o proporciónelos temporalmente al
# ejecutar `flask init-admin` (si no se definen, el CLI los solicitará de forma interactiva).
ADMIN_INIT_USERNAME=
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=

